{
  "name": "example-tanstack",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/example-tanstack/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/example-tanstack"],
      "options": { "command": "vite build", "cwd": "apps/example-tanstack" }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "vite --port 3000", "cwd": "apps/example-tanstack" }
    }
  }
}
