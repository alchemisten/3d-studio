{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2017", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@schablone/3d-studio-feature-color-switcher": ["libs/feature-color-switcher/src/index.ts"],
      "@schablone/3d-studio-feature-material-variants": ["libs/feature-material-variants/src/index.ts"],
      "@schablone/3d-studio-feature-floor": ["libs/feature-floor/src/index.ts"],
      "@schablone/3d-studio-core": ["libs/core/src/index.ts"],
      "@schablone/3d-studio-feature-wireframe": ["libs/feature-wireframe/src/index.ts"],
      "@schablone/3d-studio-feature-camera-rotation": ["libs/feature-camera-rotation/src/index.ts"],
      "@schablone/3d-studio": ["libs/studio/src/index.ts"],
      "@schablone/3d-studio-feature-skybox": ["libs/feature-skybox/src/index.ts"],
      "@schablone/3d-studio-feature-highlights": ["libs/feature-highlights/src/index.ts"],
      "@schablone/3d-studio-feature-animation": ["libs/feature-animation/src/index.ts"],
      "@schablone/3d-studio-feature-light-scenarios": ["libs/feature-light-scenarios/src/index.ts"],
      "@schablone/3d-studio-ui": ["libs/ui/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
